# WSGT BOT Configuration
# Fill in your values below. Never commit this file or share it.

# ===== DISCORD (REQUIRED) =====
# Get these from: https://discord.com/developers/applications
DISCORD_TOKEN=
CLIENT_ID=1573284432402718792
GUILD_ID=

# Bot Owners (comma-separated Discord user IDs) - YOUR user ID goes here
OWNER_IDS=

# ===== DATABASE (PostgreSQL) =====
# If using a local PostgreSQL, fill these in. Or use DATABASE_URL for hosted DB.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wsgt_bot
DB_USER=postgres
DB_PASSWORD=

# ===== DASHBOARD (Web panel) =====
DASHBOARD_PORT=3000
# Generate a strong random string (32+ chars). Use: openssl rand -hex 32
DASHBOARD_SECRET=
# Get from Discord Developer Portal -> OAuth2 -> Client Secret
DISCORD_CLIENT_SECRET=
DASHBOARD_CALLBACK_URL=http://localhost:3000/auth/callback
DASHBOARD_URL=http://localhost:3000

# ===== OPTIONAL: Lavalink (Music) =====
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# ===== OPTIONAL: Weather API =====
WEATHER_API_KEY=

# ===== LOGGING =====
LOG_LEVEL=info
NODE_ENV=development