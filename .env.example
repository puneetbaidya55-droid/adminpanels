# ============================================================
# WSGT BOT - Environment Configuration Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control!
# ============================================================

# --- Discord (Discord Developer Portal: https://discord.com/developers/applications) ---

# Bot Token (Bot tab → Reset Token → Reveal)
DISCORD_TOKEN=your_bot_token_here

# Application ID (top of any page in the app dashboard)
CLIENT_ID=your_application_id_here

# Discord OAuth Client Secret (General Information tab → Client Secret → Reveal)
DISCORD_CLIENT_SECRET=your_client_secret_here

# Your Discord Server ID (right-click server name → Copy Server ID)
# Leave blank for global command deployment
GUILD_ID=

# Bot Owner Discord IDs, comma-separated (enable Developer Mode, right-click user → Copy User ID)
OWNER_IDS=

# --- Dashboard Web UI ---

# Port for the dashboard web server
DASHBOARD_PORT=3000

# Secret key for signing Express sessions (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
DASHBOARD_SECRET=change_me

# Public URL of your dashboard (set to real domain after deploying)
DASHBOARD_URL=http://localhost:3000

# OAuth callback URL (must match the Redirect URI set in the Discord Developer Portal)
DASHBOARD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# --- Database (PostgreSQL) ---

# Full connection string (alternative to individual DB_* vars below)
DATABASE_URL=

# Database host
DB_HOST=localhost

# Database port
DB_PORT=5432

# Database name
DB_NAME=wsgt_bot

# Database user
DB_USER=postgres

# Database password
DB_PASSWORD=

# --- Lavalink (Music Bot - Optional) ---

# Lavalink server host
LAVALINK_HOST=localhost

# Lavalink server port
LAVALINK_PORT=2333

# Lavalink server password
LAVALINK_PASSWORD=youshallnotpass

# --- Weather API (Optional) ---

# API key for weather commands
WEATHER_API_KEY=

# --- Runtime ---

# Node environment: development or production
NODE_ENV=development

# Log level: error, warn, info, debug
LOG_LEVEL=info