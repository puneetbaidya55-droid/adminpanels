# WSGT BOT Configuration
# Copy this file to .env and fill in your values. Never commit .env.

# Discord
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
GUILD_ID=your_test_guild_id_optional

# Bot Owners (comma-separated Discord user IDs)
OWNER_IDS=123456789012345678

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/wsgt_bot
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wsgt_bot
DB_USER=postgres
DB_PASSWORD=your_db_password

# Dashboard
DASHBOARD_PORT=3000
DASHBOARD_SECRET=change_this_to_a_long_random_string
DISCORD_CLIENT_SECRET=your_discord_client_secret
DASHBOARD_CALLBACK_URL=http://localhost:3000/auth/callback
DASHBOARD_URL=http://localhost:3000

# Optional: Lavalink (music)
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# Optional: Weather API
WEATHER_API_KEY=

# Logging
LOG_LEVEL=info
NODE_ENV=production
